[Unit]
Description=southbay-water: South Bay drinking-water quality map
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/southbay-water
ExecStart=%h/southbay-water/.venv/bin/python -m uvicorn src.server.app:app --host 0.0.0.0 --port 8100 --log-level info
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
